# =============================================================================
# Becha-Kena API Environment Configuration
# Copy to .env for local development
# =============================================================================

# --- Server & App ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# --- Database & Cache ---
MONGODB_URI=mongodb://localhost:27017/becha-kena?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# --- Auth & Sessions ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_ACCESS_TTL=900
REFRESH_TTL_SECONDS=2592000
COOKIE_DOMAIN=localhost

# --- Cryptography & Privacy Secrets ---
NID_HMAC_SECRET=change-me-nid-hmac-secret-at-least-32-chars-long
PHONE_HMAC_SECRET=change-me-phone-hmac-secret-at-least-32-chars-long
OTP_HMAC_SECRET=change-me-otp-hmac-secret-at-least-32-chars-long
# 32-byte base64 key (generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
KYC_RESPONSE_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TOTP_ENC_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# --- Cloudflare R2 / MinIO Object Storage ---
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_PRIVATE_BUCKET=bk-private
R2_PUBLIC_BUCKET=bk-public
CDN_BASE_URL=http://localhost:9000/bk-public

# --- Porichoy e-KYC API ---
PORICHOY_MODE=mock
PORICHOY_BASE_URL=https://api.porichoybd.com
PORICHOY_API_KEY=mock-porichoy-key

# --- Dual-Gateway SMS OTP ---
SMS_MODE=mock
SMS_PRIMARY_URL=https://sms-primary.example.com/send
SMS_PRIMARY_API_KEY=mock-primary-key
SMS_PRIMARY_SENDER_ID=BechaKena
SMS_SECONDARY_URL=https://sms-secondary.example.com/send
SMS_SECONDARY_API_KEY=mock-secondary-key
SMS_SECONDARY_SENDER_ID=BechaKena

# --- Anti-Bot (Cloudflare Turnstile) ---
TURNSTILE_MODE=mock
TURNSTILE_SECRET=mock-turnstile-secret

# --- Push Notifications (FCM) ---
FCM_MODE=mock
FCM_PROJECT_ID=becha-kena-dev
FCM_CLIENT_EMAIL=firebase@becha-kena-dev.iam.gserviceaccount.com
FCM_PRIVATE_KEY=mock-private-key

# --- Search & Mobile App Version Gates ---
SEARCH_PROVIDER=local
MIN_BUILD_ANDROID=100
MIN_BUILD_IOS=100

# --- Initial Staff Seed Phones (Optional) ---
SEED_MODERATOR_PHONE=+8801700000001
SEED_COMPLIANCE_PHONE=+8801700000002
SEED_ADMIN_LEAD_PHONE=+8801700000003
