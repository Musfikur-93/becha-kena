{
  "name": "becha-kena-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @becha-kena/api dev",
